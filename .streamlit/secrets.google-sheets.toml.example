# Example only: replace every REPLACE_WITH_ value in Streamlit Settings > Secrets.
# Keep real credentials out of GitHub. This template contains no working keys.
# Keep all top-level settings BEFORE the [gcp_service_account] section.
GOOGLE_API_KEY = "REPLACE_WITH_YOUR_GEMINI_API_KEY"
APP_PASSWORD = "REPLACE_WITH_YOUR_MEMBER_PASSWORD"
GEMINI_MODEL = "REPLACE_WITH_YOUR_AVAILABLE_GEMINI_MODEL"

USAGE_STORAGE = "google_sheets"
# Use Asia/Bangkok instead if the daily count should follow Thailand time (UTC+7).
USAGE_TIMEZONE = "Asia/Shanghai"
USAGE_SHEET_ID = "1RAzxLD2cZqeOZfQtUHQQHZ3PD5oJo0bLaPx8j55A4Oo"
USAGE_SHEET_TAB = "Usage"

[gcp_service_account]
client_email = "REPLACE_WITH_SERVICE_ACCOUNT_EMAIL"
# Copy the full quoted private_key value from the downloaded JSON.
# Keep the literal \n escapes; do not copy the JSON field name or trailing comma.
private_key = "-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY_BODY\n-----END PRIVATE KEY-----\n"
