# Example only. Paste real values into Streamlit Cloud > Advanced settings > Secrets.
# For local use, copy this file to secrets.toml and replace placeholders.
# Never upload secrets.toml to GitHub.
GOOGLE_API_KEY = "REPLACE_WITH_YOUR_NEW_GEMINI_API_KEY"
APP_PASSWORD = "REPLACE_WITH_YOUR_MEMBER_PASSWORD"
# Use the model ID that works with your Gemini API key and supports images.
GEMINI_MODEL = "REPLACE_WITH_YOUR_AVAILABLE_GEMINI_MODEL"

# Keep sqlite for local storage, or set google_sheets after completing setup.
USAGE_STORAGE = "sqlite"
# Timezone used for the daily count (UTC+8 by default).
USAGE_TIMEZONE = "Asia/Shanghai"
# For Google Sheets, uncomment these top-level settings before any [section].
# USAGE_SHEET_ID = "1RAzxLD2cZqeOZfQtUHQQHZ3PD5oJo0bLaPx8j55A4Oo"
# USAGE_SHEET_TAB = "Usage"

